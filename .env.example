# Variables de la API. En local van en este archivo (.env); en Dokploy, en la pestaña Environment de la aplicación
# (ver DESPLIEGUE.md, que tiene los valores de producción).

DB_URL=jdbc:postgresql://localhost:5432/taskflow
DB_USER=taskflow
DB_PASSWORD=taskflow

JWT_SECRET=un_secreto_largo_de_al_menos_32_caracteres
# Correos: smtp (Mailpit en local: http://localhost:8025; en producción, Gmail u otro SMTP) | resend (con dominio verificado)
MAIL_PROVIDER=smtp
MAIL_FROM=TaskFlow <no-reply@taskflow.local>

# Solo con MAIL_PROVIDER=smtp. Estos valores son los de Mailpit (docker compose). Con Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USERNAME=la cuenta, SMTP_PASSWORD=una contraseña de aplicación, SMTP_AUTH=true, SMTP_STARTTLS=true,
# y MAIL_FROM con esa misma cuenta (Gmail no deja enviar como otra dirección).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# Solo con MAIL_PROVIDER=resend. Si FRONTEND_URL no es localhost, la API no arranca sin una key real.
RESEND_API_KEY=re_xxxxxxxxx

FRONTEND_URL=http://localhost:5173

# Escribir en el log los enlaces (secretos) de los correos: true | false.
# Vacío = solo los correos que no salen y si FRONTEND_URL es localhost. true = siempre, aunque el correo salga
# (útil en desarrollo si el SMTP falla). En producción, vacío o false.
MAIL_LOG_LINKS=

# none (local, sin proxy) | native (detrás de Dokploy/Traefik: la IP real del cliente sale de X-Forwarded-For)
FORWARD_HEADERS_STRATEGY=none

# Swagger UI y /v3/api-docs (el frontend genera sus tipos con /v3/api-docs). false los apaga.
SPRINGDOC_ENABLED=true

# Cloudflare R2 (archivos e imágenes). Los valores salen del panel de R2:
# Account ID (página principal de R2) y el API token de cuenta con «Object Read & Write» sobre el bucket.
# El endpoint se arma solo: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=taskflow-files

# Segundos en los que un refresh token recién rotado todavía sirve una vez más (recargas seguidas). 0 lo apaga.
REFRESH_REUSE_GRACE_SECONDS=30

# GitHub App de TaskFlow (integración con GitHub). Sin estas seis la integración queda apagada. La clave privada va como
# ruta a su .pem (local) o como su contenido en GITHUB_PRIVATE_KEY, con los saltos de línea escritos como \n (Docker).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
